# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/kisanlens?retryWrites=true&w=majority

# AI
GEMINI_API_KEY=your_gemini_api_key_here

# Weather
WEATHER_API_URL=https://api.open-meteo.com/v1

# Market
MARKET_API_URL=https://api.data.gov.in/resource
MARKET_API_KEY=your_data_gov_api_key_here

# Auth
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Client
CLIENT_URL=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
